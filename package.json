{
  "name": "edubeer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EduBeer — atlante consultabile: 613 birre citate dal BJCP 2021, 116 stili e 30 approfondimenti editoriali.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-data.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:perf": "npm run build && playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
