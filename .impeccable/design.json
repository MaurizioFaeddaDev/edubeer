      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 14px;border:1px solid var(--border,#7a8585);border-radius:var(--radius-sm,6px);font-size:var(--fs-sm,.9375rem);line-height:1.3;cursor:pointer;font-family:var(--font-body,'Source Sans 3','Segoe UI',sans-serif);}.ds-button:focus-visible{outline:3px solid var(--accent,#175a63);outline-offset:4px}.ds-button:disabled{opacity:.55;cursor:not-allowed}@media(max-width:480px){.ds-button{min-height:44px}}@media(prefers-reduced-motion:no-preference){.ds-button{transition:background-color var(--dur-1,140ms),color var(--dur-1,140ms)}}.ds-selected{background:var(--accent-soft,#e6f0f1);color:var(--accent-ink,#175a63);border-color:var(--accent,#175a63)}.ds-selected:hover{background:var(--accent-soft,#e6f0f1)}"
