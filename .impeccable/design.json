    {
      "name": "Selected removable chip",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Named comparison selection with a text-equivalent removal action.",
      "html": "<button class=\"ds-chip\" aria-label=\"Rimuovi American Light Lager dal confronto\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>1A American Light Lager <span aria-hidden=\"true\">×</span></button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:5px 11px;border:1px solid var(--accent,#175a63);border-radius:var(--radius-sm,6px);background:var(--accent-soft,#e6f0f1);color:var(--accent-ink,#175a63);font-size:var(--fs-xs,.8125rem);cursor:pointer;font-family:var(--font-body,'Source Sans 3','Segoe UI',sans-serif);}.ds-chip:hover{background:var(--surface-3,#dfe8e9)}.ds-chip:focus-visible{outline:3px solid var(--accent,#175a63);outline-offset:4px}.ds-dot{display:inline-block;flex-shrink:0;width:10px;height:10px;border-radius:50%;background:var(--series-1,#175a63)}@media(max-width:480px){.ds-chip{min-height:44px}}"
    },
    {
      "name": "Atlas navigation",
      "kind": "nav",
      "description": "Petrol active destination, underline and a small comparison count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigazione principale\"><a class=\"ds-navlink ds-current\" href=\"#/\" aria-current=\"page\">Stili</a><a class=\"ds-navlink\" href=\"#/birre\">Birre</a><a class=\"ds-navlink\" href=\"#/confronta\">Confronta <span class=\"ds-count\">2</span></a><a class=\"ds-navlink\" href=\"#/approfondimenti\">Approfondimenti</a></nav>",
      "css": ".ds-nav{display:flex;gap:24px;flex-wrap:wrap;font-family:var(--font-body,'Source Sans 3','Segoe UI',sans-serif);}.ds-navlink{display:inline-flex;align-items:center;gap:6px;position:relative;min-height:44px;color:var(--foreground-muted,#605a54);font-weight:550;text-decoration:none}.ds-current{color:var(--accent,#175a63)}.ds-current:after{content:'';position:absolute;height:2px;bottom:0;left:0;right:0;background:var(--accent,#175a63)}.ds-navlink:hover{text-decoration:underline;text-underline-offset:4px}.ds-navlink:focus-visible{outline:3px solid var(--accent,#175a63);outline-offset:4px}.ds-count{background:var(--accent-soft,#e6f0f1);color:var(--accent-ink,#175a63);border-radius:var(--radius-pill,999px);padding:1px 7px;font-size:var(--fs-xs,.8125rem)}"
    },
    {
      "name": "SRM interval",
      "kind": "custom",
      "description": "Actual 2–3 SRM example from style 1A on the 0–40 SRM comparison domain. Endpoint colors come from srmToHex; the inset espresso outline keeps pale fills visible. The tick is an interval midpoint.",
      "html": "<div class=\"ds-range\" role=\"group\" aria-label=\"Colore: confronto degli intervalli\"><div class=\"ds-row\"><div class=\"ds-name\"><span class=\"ds-code\">1A</span> <a href=\"#/stili/1A\">American Light Lager</a></div><div class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-interval\"><span class=\"ds-mid\"></span></span></div><div class=\"ds-value\">2–3 SRM</div></div><p class=\"ds-caption\">La tacca indica il punto medio dell’intervallo, non un valore misurato sulle birre.</p></div>",
      "css": ".ds-range{color:var(--foreground,#302922);font-family:var(--font-body,'Source Sans 3','Segoe UI',sans-serif);}.ds-row{display:grid;grid-template-columns:240px minmax(0,1fr) 130px;align-items:center;gap:24px;margin:22px 0}.ds-name,.ds-value{font-size:var(--fs-sm,.9375rem)}.ds-name a{color:var(--foreground,#302922);text-decoration:none}.ds-name a:hover{text-decoration:underline}.ds-name a:focus-visible{outline:3px solid var(--accent,#175a63);outline-offset:4px}.ds-code{color:var(--accent-ink,#175a63);font-weight:600}.ds-value{text-align:right;font-variant-numeric:tabular-nums}.ds-track{height:20px;position:relative;background:var(--surface-2,#edf2f3);border-radius:3px}.ds-interval{position:absolute;left:5%;width:2.5%;min-width:3px;top:6px;height:8px;border-radius:3px;background:linear-gradient(90deg,#f4e995,#f1e07e);outline:1px solid var(--foreground,#302922);outline-offset:-1px}.ds-mid{position:absolute;left:50%;top:-3px;height:14px;width:2px;background:var(--foreground,#302922)}.ds-caption{color:var(--foreground-muted,#605a54);font-size:var(--fs-sm,.9375rem);line-height:1.5}@media(max-width:760px){.ds-row{grid-template-columns:1fr auto;gap:10px;margin:24px 0}.ds-track{grid-column:1/-1;grid-row:2}.ds-value{grid-column:2;grid-row:1}.ds-name a{overflow-wrap:anywhere}}"
    },
    {
